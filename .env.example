# ── Base de datos (Railway genera DATABASE_URL automáticamente) ──
DATABASE_URL=postgresql://user:password@host:5432/seven_db

# ── JWT ──────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# ── Servidor ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── CORS — URL del frontend (Nginx local) ────────────────────────
# Usar * para desarrollo, IP del PC en producción
CORS_ORIGIN=http://192.168.1.10

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Timezone (Lima, Perú) ────────────────────────────────────────────────────
TZ=America/Lima
PGTZ=America/Lima
